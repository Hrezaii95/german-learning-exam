    ],
    "lines": [
      {
        "speaker": "Mann",
        "text": "Variieren Sie. Beispiel:"
      },
      {
        "speaker": "Frau",
        "text": "Was machst du beruflich? (Student)"
      },
      {
        "speaker": "Mann",
        "text": "Ich bin Student."
      },
      {
        "speaker": "Mann",
        "text": "Und jetzt Sie:"
      },
      {
        "speaker": "Frau",
        "text": "Was machst du beruflich? (Schülerin)"
      },
      {
        "speaker": "Mann",
        "text": "Ich bin Schülerin."
      },
      {
        "speaker": "Frau",
        "text": "Was bist du von Beruf? (Architektin)"
      },
      {
        "speaker": "Mann",
        "text": "Ich bin Architektin."
      },
      {
        "speaker": "Frau",
        "text": "Was sind Sie von Beruf? (Job als Verkäufer)"
      },
      {
        "speaker": "Mann",
        "text": "Ich habe einen Job als Verkäufer."
      },
      {
        "speaker": "Frau",
        "text": "Was machst du beruflich? (Ausbildung als Friseurin)"
      },
      {
        "speaker": "Mann",
        "text": "Ich mache eine Ausbildung als Friseurin."
      },
      {
        "speaker": "Frau",
        "text": "Was machen Sie beruflich? (Praktikum bei Hotsped)"
      },
      {
        "speaker": "Mann",
        "text": "Ich mache ein Praktikum bei Hotsped."
      },
      {
        "speaker": "Frau",
        "text": "Was sind Sie von Beruf? – Lehrer"
      },
      {
        "speaker": "Mann",
        "text": "Ich bin Lehrer."
      }
    ]
  },
  "1_21": {
    "sourcePages": [
      3
    ],
    "lines": [
      {
        "speaker": "Mann",
        "text": "Hören Sie die Sätze und fragen Sie. Beispiel:"
      },
      {
        "speaker": "Frau",
        "text": "Ich komme aus Spanien. (du?)"
      },
      {
        "speaker": "Mann",
        "text": "Woher kommst du?"
      },
      {
        "speaker": "Mann",
        "text": "Und jetzt Sie:"
      },
      {
        "speaker": "Frau",
        "text": "Ich komme aus Spanien. (du?)"
      },
      {
        "speaker": "Mann",
        "text": "Woher kommst du?"
      },
      {
        "speaker": "Frau",
        "text": "Ich heiße Jan. (du?)"
      },
      {
        "speaker": "Mann",
        "text": "Wie heißt du?"
      },
      {
        "speaker": "Frau",
        "text": "Ich bin Susanne. (du?)"
      },
      {
        "speaker": "Mann",
        "text": "Wer bist du?"
      },
      {
        "speaker": "Frau",
        "text": "Ich heiße Veronika Müller. (Sie?)"
      },
      {
        "speaker": "Mann",
        "text": "Wie heißen Sie?"
      },
      {
        "speaker": "Frau",
        "text": "Das ist Paul. (das?)"
      },
      {
        "speaker": "Mann",
        "text": "Wer ist das?"
      },
      {
        "speaker": "Frau",
        "text": "Ich heiße Monika Rühmann. (Sie?)"
      },
      {
        "speaker": "Mann",
        "text": "Wie heißen Sie?"
      },
      {
        "speaker": "Frau",
        "text": "Hallo, ich heiße Marion. (du?)"
      },
      {
        "speaker": "Mann",
        "text": "Wie heißt du?"
      },
      {
        "speaker": "Frau",
        "text": "Ich komme aus Österreich. (Sie?)"
      },
      {
        "speaker": "Mann",
        "text": "Woher kommen Sie?"
      }
    ]
  },
  "1_22": {
    "sourcePages": [
      3,
      4
    ],
    "lines": [
      {
        "speaker": "Mann",
        "text": "Sagen Sie „nein“ und variieren Sie. Beispiel:"
      },
      {
        "speaker": "Frau",
        "text": "Sabine ist Friseurin. (Lehrerin)"
      },
      {
        "speaker": "Mann",
        "text": "Nein, Sabine ist nicht Friseurin. Sie ist Lehrerin."
      },
      {
        "speaker": "Mann",
        "text": "Und jetzt Sie."
      },
      {
        "speaker": "Frau",
        "text": "Astrid und Norbert sind verheiratet. (geschieden)"
      },
      {
        "speaker": "Mann",
        "text": "Nein, Astrid und Norbert sind nicht verheiratet. Sie sind geschieden."
      },
      {
        "speaker": "Frau",
        "text": "Carla lebt allein. (zusammen mit Peter)"
      },
      {
        "speaker": "Mann",
        "text": "Nein, Carla lebt nicht allein. Sie lebt zusammen mit Peter."
      },
      {
        "speaker": "Frau",
        "text": "Sie wohnen in Zürich. (Bern)"
      },
      {
        "speaker": "Mann",
        "text": "Nein, sie wohnen nicht in Zürich. Sie wohnen in Bern."
      },
      {
        "speaker": "Frau",
        "text": "Sie ist 19 Jahre alt. (21)"
      },
      {
        "speaker": "Mann",
        "text": "Nein, sie ist nicht 19 Jahre alt. Sie ist 21."
      },
      {
        "speaker": "Frau",
        "text": "Frau Wachter ist Lehrerin. (Journalistin)"
      },
      {
        "speaker": "Mann",
        "text": "Nein, Frau Wachter ist nicht Lehrerin. Sie ist Journalistin."
      }
    ]
  },
