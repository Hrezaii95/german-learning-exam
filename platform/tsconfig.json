{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@german-learning/content": ["packages/content/src/index.ts"],
      "@german-learning/content/*": ["packages/content/src/*"],
      "@german-learning/learning": ["packages/learning/src/index.ts"],
      "@german-learning/learning/*": ["packages/learning/src/*"]
    }
  },
  "include": [
    "packages/content/src/**/*.ts",
    "packages/learning/src/**/*.ts",
    "apps/web/lib/**/*.ts",
    "apps/web/scripts/**/*.ts",
    "tests/content/**/*.ts",
    "tests/learning/**/*.ts",
    "tests/web/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "**/dist",
    "apps/web/lib/recorder/**",
    "apps/web/lib/content/enrichment-client.ts",
    "tests/web/p2a-studio-dashboard-ui.test.ts",
    "tests/web/p2b-hub-card-anatomy-ui.test.ts",
    "tests/web/p2a-studio-dashboard-behavior.test.ts",
    "tests/web/p3a-web-shell-ui.test.ts",
    "tests/web/p3ar2-proxy.test.ts",
    "tests/web/p3b-hubs-ui.test.ts",
    "tests/web/p3c-search-ui.test.ts",
    "tests/web/p3d-details-ui.test.ts",
    "tests/web/p4a-games-ui.test.ts",
    "tests/web/p4a-games-behavior.test.ts",
    "tests/web/p4b-conversation-ui.test.ts",
    "tests/web/p4b-conversation-behavior.test.ts",
    "tests/web/p4b-spoken-behavior.test.ts",
    "tests/web/p4b-recorder-lifecycle-behavior.test.ts",
    "tests/web/p4c-learner-ui-behavior.test.ts",
    "tests/web/p5-media-integration.test.ts",
    "tests/web/p5-rich-visuals.test.ts",
    "tests/web/p5-profession-concept-illustrations.test.ts",
    "tests/web/p5-rapid-content.test.ts",
    "tests/web/j1-activity-runtime.test.ts",
    "tests/web/activity-content-behavior.test.ts",
    "tests/web/activity-content-plans.test.ts",
    "tests/web/listening-concepts-hubs.test.ts",
    "tests/web/extra-professions-ui.test.ts",
    "tests/web/p5-instructional-visual-system.test.ts",
    "tests/web/pronunciation-control-behavior.test.ts",
    "tests/web/lesson-label-ui.test.ts",
    "tests/web/p6-a11y-remediation-behavior.test.ts"
  ]
}
