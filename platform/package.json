{
  "name": "german-learning-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "German Learning OS platform workspace (content schemas first)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:web": "npm run typecheck -w @german-learning/web",
    "typecheck:web-tests": "npm run typecheck:tests -w @german-learning/web",
    "lint:web": "eslint apps/web --max-warnings=0",
    "test": "vitest run --config vitest.config.ts",
    "test:web": "vitest run --config vitest.config.ts tests/web",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "typecheck:e2e": "tsc --noEmit -p tests/e2e/tsconfig.json",
    "project:web": "npm run project -w @german-learning/web",
    "build:web": "npm run build -w @german-learning/web",
    "build:pages": "npm run build:pages -w @german-learning/web",
    "check": "npm run typecheck && npm run typecheck:web && npm run typecheck:web-tests && npm run lint:web && npm test && npm run validate:publication && npm run test:web",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "smoke:web-routes": "npm run smoke:routes -w @german-learning/web",
    "smoke:dev": "npm run smoke:dev -w @german-learning/web",
    "smoke:pages": "npm run smoke:pages -w @german-learning/web",
    "audit:learner-language": "node ../tools/audit-learner-language.mjs",
    "audit:offline": "node ../tools/audit-offline-export.mjs",
    "icons:app": "npm run icons:app -w @german-learning/web",
    "gates:pages": "npm run build:pages && npm run smoke:pages && npm run audit:learner-language && npm run audit:offline && npm run audit:word-cards -- --export",
    "audit:word-cards": "node ../tools/audit-word-cards.mjs --audio",
    "validate:fixture": "tsx packages/content/src/cli/validate.ts tests/content/fixtures/valid-lesson-01-bundle.json",
    "validate:publication": "tsx packages/content/src/cli/validate-publication.ts",
    "encode:publication": "tsx packages/content/src/cli/encode-publication.ts",
    "validate": "tsx packages/content/src/cli/validate.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^22.13.10",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^6.1.1",
    "globals": "^16.5.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.0.8"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
