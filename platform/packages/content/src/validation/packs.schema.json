    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "language": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "cefr": {
      "enum": [
        "A1",
        "A2",
        "B1",
        "B2",
        "C1",
        "C2"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "canDo": {
            "type": "array",
