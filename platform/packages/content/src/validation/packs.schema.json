            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "rows": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "cols": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "title",
          "rows",
          "cols"
