{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "title",
    "taskRefs"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "taskRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "title": "Wortwerk exam resource"
}
