{
  "name": "german-web-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-22",
  "workers_dev": false,
  "assets": {
    "directory": "../web/out", "binding": "ASSETS",
    "html_handling": "force-trailing-slash", "not_found_handling": "404-page",
    "run_worker_first": ["/api", "/api/*"]
  },
  "d1_databases": [{
    "binding": "DB", "database_name": "german-db-local",
    "database_id": "00000000-0000-0000-0000-000000000001", "migrations_dir": "migrations"
  }],
  "vars": { "BUILD_SHA": "local-rehearsal" }
}
