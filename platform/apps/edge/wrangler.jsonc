{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "german-web",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-22",
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    { "pattern": "german.learnilabs.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "../web/out",
    "binding": "ASSETS",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api", "/api/*"]
  },
  "vars": {
    "BUILD_SHA": "development"
  },
  "env": {
    "preview": {
      "name": "german-web-preview",
      "workers_dev": true,
      "preview_urls": true,
      "routes": [],
      "assets": {
        "directory": "../web/out",
        "binding": "ASSETS",
        "html_handling": "force-trailing-slash",
        "not_found_handling": "404-page",
        "run_worker_first": ["/api", "/api/*"]
      },
      "vars": {
        "BUILD_SHA": "development"
      }
    }
  }
}
